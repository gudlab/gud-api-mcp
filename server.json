{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gudlab/gud-api-mcp",
  "description": "AI agents create, run, and save API requests as Gud API collections in your project.",
  "version": "0.1.2",
  "repository": {
    "url": "https://github.com/gudlab/gud-api",
    "source": "github"
  },
  "websiteUrl": "https://gudapi-docs.gudlab.org/guide/ai-agents",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@gudlab/gud-api-mcp",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--project",
          "value": ".",
          "description": "Project folder whose .gud-api/ the server reads and writes. Defaults to current dir.",
          "isRequired": false,
          "isRepeated": false
        }
      ],
      "environmentVariables": []
    }
  ]
}
